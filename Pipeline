    M3= Cluster_streams_norm(:,:,ii);
    clust_dependency(1,ii) = sum(M3(RR_con_mask))/sum(Mraw(RR_con_mask));
    clust_dependency(2,ii) = sum(M3(PP_con_mask))/sum(Mraw(PP_con_mask));
    clust_dependency(3,ii) = sum(M3(RP_con_mask))/sum(Mraw(RP_con_mask));
end
[~,p,~,stats] = ttest(clust_dependency(1,:),clust_dependency(2,:));
RC_origpval(1,1) = p;
RC_origpval(1,2) = stats.tstat;
[~,p,~,stats] = ttest(clust_dependency(1,:),clust_dependency(3,:));
RC_origpval(2,1) = p;
RC_origpval(2,2) = stats.tstat;
[~,p,~,stats] = ttest(clust_dependency(2,:),clust_dependency(3,:));
RC_origpval(3,1) = p;
RC_origpval(3,2) = stats.tstat;
